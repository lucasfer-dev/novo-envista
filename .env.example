# Supabase / Next.js
# Runtime suportado desta integração: Node.js 22.x.
# Copie para .env.local no desenvolvimento e configure os mesmos nomes na Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave server-side usada SOMENTE para emitir tickets curtos de verificação de identidade.
# Prefira a Secret Key atual do Supabase. Em projetos legados, SERVICE_ROLE pode ser usado como fallback.
# NUNCA use NEXT_PUBLIC_ e nunca exponha esta chave ao navegador.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# URL pública usada em links de confirmação e recuperação enviados por e-mail.
# Desenvolvimento local: http://localhost:3000
# Produção: https://useenvista.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cadastro. Ative somente nos ambientes em que você realmente quer aceitar contas.
AUTH_SIGNUP_ENABLED=false

# CAPTCHA opcional. Quando a site key estiver definida, login, cadastro e recuperação
# exigem o token do Cloudflare Turnstile. A Secret Key fica SOMENTE no painel do
# Supabase Auth (Bot and Abuse Protection), nunca em NEXT_PUBLIC_* nem no repositório.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Consulta CPF v3 / Serpro. Credenciais exclusivamente server-side.
# Obtenha Consumer Key e Consumer Secret na área do cliente Serpro após contratar/habilitar a API.
# NUNCA use NEXT_PUBLIC_ e nunca faça commit dos valores reais.
SERPRO_CPF_CONSUMER_KEY=
SERPRO_CPF_CONSUMER_SECRET=
SERPRO_TOKEN_URL=https://gateway.apiserpro.serpro.gov.br/token
SERPRO_CPF_BASE_URL=https://gateway.apiserpro.serpro.gov.br/consulta-cpf-df/v3

# Nunca exponha service_role, sb_secret_*, senha do banco, credenciais do Serpro
# ou outras credenciais privilegiadas em NEXT_PUBLIC_* ou no código do cliente.
