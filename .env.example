# Supabase / Next.js
# Runtime suportado desta integração: Node.js 22.x.
# Copie para .env.local no desenvolvimento e configure os mesmos nomes na Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública usada em links de confirmação e recuperação enviados por e-mail.
# Desenvolvimento local: http://localhost:3000
# Produção: https://useenvista.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Assina o marcador HttpOnly de uma sessão de recuperação. Obrigatório em produção.
# Gere pelo menos 32 bytes aleatórios (ex.: `openssl rand -base64 48`).
# Nunca prefixe com NEXT_PUBLIC_ e nunca reutilize a publishable key do Supabase.
AUTH_RECOVERY_COOKIE_SECRET=

# Cadastro público.
# Disponível por padrão. Defina AUTH_SIGNUP_ENABLED=false somente para pausar
# novas contas em manutenção ou incidente. CAPTCHA continua sendo exigido
# automaticamente quando NEXT_PUBLIC_TURNSTILE_SITE_KEY estiver configurada.
AUTH_SIGNUP_ENABLED=true

# Cloudflare Turnstile para login, cadastro e recuperação.
# A Secret Key fica SOMENTE no painel do Supabase Auth (Bot and Abuse Protection),
# nunca em NEXT_PUBLIC_* nem no repositório.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Nunca exponha service_role, sb_secret_*, senha do banco ou outras credenciais
# privilegiadas em NEXT_PUBLIC_* ou no código do cliente.

# Identificação e canais jurídicos públicos
LEGAL_CONTROLLER_NAME=Envista
LEGAL_CONTROLLER_DOCUMENT=
LEGAL_PRIVACY_EMAIL=privacidade@useenvista.com.br
LEGAL_SUPPORT_EMAIL=suporte@useenvista.com.br

# GitHub App / integração de repositórios
# Crie um GitHub App e configure a Setup URL como:
# https://useenvista.com.br/api/github/callback
# Configure o webhook em:
# https://useenvista.com.br/api/github/webhook
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Conteúdo do arquivo .pem do GitHub App convertido para base64.
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_WEBHOOK_SECRET=

# Necessária somente no backend para processar webhooks assinados.
# Nunca exponha esta variável no cliente e nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Google Search Console HTML tag verification token (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
