# Supabase / Next.js
# Runtime suportado desta integração: Node.js 22.x.
# Copie para .env.local no desenvolvimento e configure os mesmos nomes na Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Desenvolvimento local: http://localhost:3000
# Produção: use o domínio público oficial, por exemplo https://novo-envista.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cadastro. Ative somente nos ambientes em que você realmente quer aceitar contas.
AUTH_SIGNUP_ENABLED=false

# CAPTCHA opcional. Quando a site key estiver definida, login, cadastro e recuperação
# exigem o token do Cloudflare Turnstile. A Secret Key fica SOMENTE no painel do
# Supabase Auth (Bot and Abuse Protection), nunca em NEXT_PUBLIC_* nem no repositório.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Nunca exponha service_role, sb_secret_*, senha do banco ou outras credenciais
# privilegiadas em NEXT_PUBLIC_* ou no código do cliente.
